{
    "name": "magefan/module-birthday-email",
    "description": "Send birthday email to the customers by cron every day",
    "require": {
        "magefan/module-community" : ">=2.4.14"
    },
    "type": "magento2-module",
    "authors": [
        {
            "email": "support@magefan.com",
            "name": "Ihor Vansach"
        }
    ],
    "version": "2.0.2",
    "autoload": {
        "files": [ "registration.php" ],
        "psr-4": {
            "Magefan\\BirthdayEmail\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
